!  THE OPERA CLOAKROOM
!
!  A small original demo game for testing interactive-fiction tools,
!  written in the style of the classic beginner's IF exercise "Cloak
!  of Darkness" (three rooms, a cloak, a dark room, a thing to find).
!  This text and code are original to this project.

Constant Story "The Opera Cloakroom";
Constant Headline "^A short demo game.^";

Release 1;
Serial "260907";

Include "Parser";
Include "VerbLib";

[ UpdateBarLight;
    if (cloak in player) give Bar ~light; else give Bar light;
];

Object  Foyer "Foyer of the Opera House"
  with  description
            "You are standing in a spacious hall, splendidly decorated
            in red and gold, with glittering chandeliers overhead. The
            entrance from the street is to the north, and there are
            doorways south and west.",
        s_to Bar,
        w_to Cloakroom,
        n_to "You've only just arrived, and besides, the weather
             outside seems to be getting worse.",
  has   light;

Object  Cloakroom "Cloakroom"
  with  description
            "The walls of this small room were clearly once lined with
            hooks, though now only one, low down, remains. The exit is
            a door to the east.",
        e_to Foyer,
  has   light;

Object  hook "small brass hook" Cloakroom
  with  name 'small' 'brass' 'hook',
        article "a",
        before [;
            Take:
                if (self hasnt moved && cloak in player)
                    "You'd have to take the cloak off the hook first.";
                "The hook is fixed to the wall.";
        ],
  has   supporter static;

Object  cloak "cloak"
  with  name 'cloak' 'velvet' 'black',
        description
            "A handsome cloak, of velvet trimmed with satin, and
            slightly spattered with raindrops. Its blackness is so
            deep that it almost seems to suck light from the room.",
        before [;
            Drop:
                if (location == Cloakroom) {
                    move self to hook;
                    UpdateBarLight();
                    "You put the cloak on the hook.";
                }
        ],
        after [;
            Wear, Disrobe, Take, PutOn:
                UpdateBarLight();
                rfalse;
        ],
  has   worn clothing;

Object  Bar "Foyer bar"
  with  description
            "The bar, much rougher than you'd have guessed after the
            opulence of the foyer to the north, is busy and noisy.
            There is a small brass plaque fixed to the bar top, and
            a silver bell sits within reach.",
        n_to Foyer,
  has   light;

Object  plaque "brass plaque" Bar
  with  name 'brass' 'plaque' 'sign',
        description
            "Engraved in careful lettering, it reads: ~Ring the bell
            for service.~",
  has   scenery;

Object  bell "silver bell" Bar
  with  name 'silver' 'bell',
        description "A small, well-polished silver bell.",
        before [;
            Take:
                deadflag = 2;
                "You scoop up the little bell. Delighted with your
                find, a waiter rushes over, impressed that you found
                your way here in the dark, and upgrades you to the
                best table in the house.^^*** You have won ***";
        ];

[ Initialise;
    location = Foyer;
    move cloak to player;
    give cloak worn;
    UpdateBarLight();
    "^^Hurrying through the rainswept November night, you're glad to
    see the bright lights of the Opera House. It's surprising that
    there aren't more people about, but hey, what do you expect on a
    night like this?^";
];

Include "Grammar";
